{
  "name": "pdf-viewer-diff",
  "displayName": "PDF View & Compare",
  "description": "View PDF files in VS Code and compare them visually",
  "version": "0.1.7",
  "publisher": "eci99",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/eci99/vscode-pdf-viewer-diff.git"
  },
  "bugs": {
    "url": "https://github.com/eci99/vscode-pdf-viewer-diff/issues"
  },
  "homepage": "https://github.com/eci99/vscode-pdf-viewer-diff#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "pdf",
    "pdf viewer",
    "pdf diff",
    "compare",
    "diff",
    "preview",
    "latex",
    "pdf.js"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "pdfViewer.preview",
        "displayName": "PDF Viewer",
        "selector": [
          {
            "filenamePattern": "*.pdf"
          }
        ],
        "priority": {
          "textEditor": "default",
          "diffEditor": "default"
        }
      },
      {
        "viewType": "pdfViewer.compare",
        "displayName": "PDF Comparison",
        "selector": [
          {
            "filenamePattern": "*.pdfdiff"
          }
        ],
        "priority": "default"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "pdfViewer.dropZone",
          "name": "PDF Compare",
          "when": "pdfViewer.pdfOpen",
          "icon": "images/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "pdfViewer.compare",
        "title": "Compare PDF with…",
        "category": "PDF View & Compare",
        "icon": "$(diff)"
      },
      {
        "command": "pdfViewer.nextDifference",
        "title": "Go to Next Difference",
        "category": "PDF View & Compare"
      },
      {
        "command": "pdfViewer.previousDifference",
        "title": "Go to Previous Difference",
        "category": "PDF View & Compare"
      },
      {
        "command": "pdfViewer.acceptCurrent",
        "title": "Accept Current",
        "category": "PDF View & Compare"
      },
      {
        "command": "pdfViewer.acceptIncoming",
        "title": "Accept Incoming",
        "category": "PDF View & Compare"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "pdfViewer.compare",
          "when": "resourceExtname == .pdf",
          "group": "3_compare"
        }
      ],
      "editor/title": [
        {
          "command": "pdfViewer.compare",
          "when": "activeCustomEditorId == pdfViewer.preview",
          "group": "navigation"
        },
        {
          "command": "pdfViewer.acceptCurrent",
          "when": "activeCustomEditorId == pdfViewer.compare && pdfViewer.mergeActive",
          "group": "navigation@1"
        },
        {
          "command": "pdfViewer.acceptIncoming",
          "when": "activeCustomEditorId == pdfViewer.compare && pdfViewer.mergeActive",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "pdfViewer.nextDifference",
          "when": "activeCustomEditorId == pdfViewer.compare"
        },
        {
          "command": "pdfViewer.previousDifference",
          "when": "activeCustomEditorId == pdfViewer.compare"
        },
        {
          "command": "pdfViewer.acceptCurrent",
          "when": "activeCustomEditorId == pdfViewer.compare && pdfViewer.mergeActive"
        },
        {
          "command": "pdfViewer.acceptIncoming",
          "when": "activeCustomEditorId == pdfViewer.compare && pdfViewer.mergeActive"
        }
      ]
    },
    "keybindings": [
      {
        "command": "pdfViewer.nextDifference",
        "key": "f8",
        "when": "activeCustomEditorId == pdfViewer.compare"
      },
      {
        "command": "pdfViewer.previousDifference",
        "key": "shift+f8",
        "when": "activeCustomEditorId == pdfViewer.compare"
      },
      {
        "command": "pdfViewer.nextDifference",
        "key": "alt+f8",
        "when": "activeCustomEditorId == pdfViewer.compare"
      },
      {
        "command": "pdfViewer.previousDifference",
        "key": "shift+alt+f8",
        "when": "activeCustomEditorId == pdfViewer.compare"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package"
  },
  "dependencies": {
    "pdfjs-dist": "^6.4.299"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/vscode": "1.90",
    "@vscode/vsce": "^4.1.0",
    "typescript": "^7.0.2"
  }
}
