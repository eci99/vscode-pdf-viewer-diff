{
  "name": "vscode-pdfviewer",
  "displayName": "PDF Viewer",
  "description": "PDF-Dateien direkt in VS Code anzeigen",
  "version": "0.1.0",
  "publisher": "local",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "pdfViewer.preview",
        "displayName": "PDF Viewer",
        "selector": [
          {
            "filenamePattern": "*.pdf"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "pdfViewer.compare",
        "displayName": "PDF-Vergleich",
        "selector": [
          {
            "filenamePattern": "*.pdfdiff"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "pdfViewer.compare",
        "title": "PDF vergleichen mit…",
        "category": "PDF Viewer",
        "icon": "$(diff)"
      },
      {
        "command": "pdfViewer.nextDifference",
        "title": "Zum nächsten Unterschied",
        "category": "PDF Viewer"
      },
      {
        "command": "pdfViewer.previousDifference",
        "title": "Zum vorherigen Unterschied",
        "category": "PDF Viewer"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "pdfViewer.compare",
          "when": "resourceExtname == .pdf",
          "group": "3_compare"
        }
      ],
      "editor/title": [
        {
          "command": "pdfViewer.compare",
          "when": "activeCustomEditorId == pdfViewer.preview",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "pdfViewer.nextDifference",
          "when": "activeCustomEditorId == pdfViewer.compare"
        },
        {
          "command": "pdfViewer.previousDifference",
          "when": "activeCustomEditorId == pdfViewer.compare"
        }
      ]
    },
    "keybindings": [
      {
        "command": "pdfViewer.nextDifference",
        "key": "f8",
        "when": "activeCustomEditorId == pdfViewer.compare"
      },
      {
        "command": "pdfViewer.previousDifference",
        "key": "shift+f8",
        "when": "activeCustomEditorId == pdfViewer.compare"
      },
      {
        "command": "pdfViewer.nextDifference",
        "key": "alt+f8",
        "when": "activeCustomEditorId == pdfViewer.compare"
      },
      {
        "command": "pdfViewer.previousDifference",
        "key": "shift+alt+f8",
        "when": "activeCustomEditorId == pdfViewer.compare"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package"
  },
  "dependencies": {
    "pdfjs-dist": "^6.4.299"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/vscode": "1.90",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^7.0.2"
  }
}
